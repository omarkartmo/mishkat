# ==============================================================================
# MISHKAT LIBRARY MANAGEMENT SYSTEM — CONFIGURATION TEMPLATE
# ==============================================================================

# NODE_ENV: Application environment mode (production | development | test)
NODE_ENV=production

# PORT: Server HTTP port (defaults to 3000)
PORT=3000

# JWT_SECRET: Secret key for signing authentication tokens (MANDATORY IN ALL MODES)
# MUST be at least 32 characters long. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_CRYPTOGRAPHICALLY_SECURE_SECRET_AT_LEAST_32_CHARS_LONG

# JWT_EXPIRES_IN: Lifetime of authentication session tokens (defaults to 7d)
JWT_EXPIRES_IN=7d

# DATABASE_URL: Optional external PostgreSQL connection string (e.g., postgres://user:pass@localhost:5432/mishkat_db)
# If left empty, the server automatically uses its embedded ACID-compliant PostgreSQL engine in LibraryData/pgdata/
DATABASE_URL=

# CENTRAL_STORAGE_DIR / DATA_DIRECTORY: Root directory for library persistent storage (defaults to ./LibraryData)
CENTRAL_STORAGE_DIR=

# CORS_ORIGINS: Comma-separated list of additional allowed web origins for cross-origin LAN clients
# Note: Localhost (127.0.0.1) and standard private RFC 1918 LAN subnets (192.168.x.x, 10.x.x.x, 172.16-31.x.x) are allowed automatically
CORS_ORIGINS=

# MAX_FILE_SIZE_MB: Maximum allowed size in megabytes for digital book and cover uploads (defaults to 100)
MAX_FILE_SIZE_MB=100

# GEMINI_API_KEY: Optional API key for Google Gemini AI features
GEMINI_API_KEY=
