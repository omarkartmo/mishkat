@echo off
chcp 65001 > nul
title نظام المشكاة لإدارة المكتبات المدرسية - تشغيل الخادم المركزي
color 0A

echo ================================================================
echo           نظام المشكاة لإدارة المكتبات المدرسية
echo       Mishkat School Library Central Server Launcher
echo ================================================================
echo.

:: 1. التحقق من تثبيت Node.js
where npm >nul 2>nul
if %errorlevel% neq 0 (
    color 0C
    echo [خطأ] برنامج Node.js غير مثبت على هذا الحاسوب!
    echo يرجى تحميله وتثبيته أولاً مجاناً من: https://nodejs.org
    echo.
    pause
    exit /b
)

:: 2. استخراج عنوان IP المحلي للحاسوب على الشبكة
set "LOCAL_IP="
for /f "tokens=4" %%a in ('route print ^| findstr "\<0.0.0.0\>"') do (
    if not defined LOCAL_IP set "LOCAL_IP=%%a"
)
if not defined LOCAL_IP set "LOCAL_IP=localhost"

:: 3. التثبيت الأولي للمكتبات إذا لم تكن موجودة
if not exist node_modules (
    echo [1/3] جاري تثبيت الحزم والمكتبات لأول مرة، يرجى الانتظار قليلاً...
    call npm install
    echo.
)

:: 4. عرض تعليمات الدخول للهاتف والحواسيب الأخرى
cls
color 0A
echo ================================================================
echo        🚀 تم تشغيل الخادم المركزي لنظام المشكاة بنجاح!
echo ================================================================
echo.
echo  [💻] للدخول من هذا الحاسوب (أمين المكتبة):
echo       http://localhost:3000
echo.
echo  [📱] للدخول من هاتفك النقال أو حواسيب الطلبة (عبر نفس الواي فاي):
echo       http://%LOCAL_IP%:3000
echo.
echo ================================================================
echo  * تأكد أن الهاتف متصل بنفس شبكة الـ Wi-Fi المتصل بها هذا الحاسوب.
echo  * لا تغلق هذه النافذة السوداء أثناء عمل النظام.
echo ================================================================
echo.

:: 5. فتح المتصفح على الحاسوب المركزي تلقائياً بعد ثانيتين
start "" cmd /c "timeout /t 2 >nul & start http://localhost:3000"

:: 6. بدء تشغيل الخادم ومشاركته على الشبكة
npm run dev
