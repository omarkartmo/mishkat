@echo off
chcp 65001 >nul
title تحديث نظام المشكاة للمكتبات - One-Click Update
color 0B

echo ===================================================
echo     نظام المشكاة لإدارة المكتبات المدرسية
echo     أداة التحديث السريع بنقرة واحدة (One-Click Update)
echo ===================================================
echo.

set SCRIPT_DIR=%~dp0
cd /d "%SCRIPT_DIR%"

echo [1/3] فحص وجود اتصال وتحديثات جديدة...
if exist ".git" (
    echo [2/3] جلب أحدث التحديثات والتحسينات من المستودع...
    git pull
) else (
    echo [!] لم يتم العثور على مستودع Git محلي.
    echo لتطبيق تحديث تم تحميله كـ ZIP: استبدل ملفات مجلد المشروع بالملفات الجديدة مع الإبقاء على ملفات التخزين.
)

echo.
echo [3/3] التحقق من الحزم وتحديث التبعيات...
call npm install

echo.
echo ===================================================
echo     تمت عملية التحديث بنجاح!
echo     يمكنك الآن تشغيل البرنامج والاستفادة من كافة التحسينات.
echo ===================================================
echo.
pause
