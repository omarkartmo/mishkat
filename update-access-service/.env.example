# ==============================================================================
# MISHKAT UPDATE ACCESS SERVICE — CONFIGURATION TEMPLATE
# ==============================================================================

# PORT: Server HTTP port (defaults to 3001)
PORT=3001

# GITHUB_APP_ID: The App ID of the GitHub App installed on the organization/repository
GITHUB_APP_ID=

# GITHUB_INSTALLATION_ID: The Installation ID of the GitHub App for the specific repository
GITHUB_INSTALLATION_ID=

# GITHUB_PRIVATE_KEY: The RSA Private Key generated for the GitHub App (PEM format)
GITHUB_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# MISHKAT_TARGET_REPO: The repository to fetch releases from
MISHKAT_TARGET_REPO=omarkartmo/mishkat
